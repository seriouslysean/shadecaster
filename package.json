{
  "name": "shadecaster",
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based shadow lamp STL generator",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "echo 'No unit tests yet' && exit 0",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run type-check && npm run build",
    "tools:stl-diff": "tsx tools/stl-diff.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "astro",
    "stl",
    "3d-printing",
    "shadow-lamp"
  ],
  "author": "Sean Kennedy",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.1.0",
    "astro": "^7.4.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
