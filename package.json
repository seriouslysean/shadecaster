{
  "name": "shadecaster",
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based shadow lamp STL generator",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "echo 'No unit tests yet' && exit 0",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "ci": "npm run lint && npm run type-check && npm run build",
    "tools:stl-diff": "tsx tools/stl-diff.ts"
  },
  "keywords": [
    "astro",
    "stl",
    "3d-printing",
    "shadow-lamp"
  ],
  "author": "Sean Kennedy",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "astro": "^5.16.11",
    "cypress": "^15.9.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
