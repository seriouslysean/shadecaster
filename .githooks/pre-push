#!/usr/bin/env bash
# pre-push: run scripts/check, what CI runs. Enable once per clone:
#   git config core.hooksPath .githooks
# Never skip it: a failure here is one CI would report. This file is the template every repo
# copies byte for byte from splitleafhq/.github; change it there, where scripts/test-pre-push tests it.
set -euo pipefail
# Git's repo variables break tools run from a linked worktree.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
cd "$(git rev-parse --show-toplevel)"
# The check tests this working tree, so it must be exactly what is pushed.
head=$(git rev-parse HEAD)
while read -r _ sha _ _; do
  # A deleted ref sends zeros; an annotated tag sends its tag object, so compare the commit it names.
  [[ $sha == 0000000000000000000000000000000000000000 ]] && continue
  [[ $(git rev-parse "$sha^{commit}") == "$head" ]] && continue
  echo "pre-push: pushing $sha but HEAD is $head; check out the branch you push" >&2
  exit 1
done
# Its own line, so set -e refuses the push when status itself fails.
status=$(git status --porcelain)
if [[ -n $status ]]; then
  echo "pre-push: uncommitted changes; commit or stash them so the check tests what is pushed" >&2
  exit 1
fi
exec scripts/check
